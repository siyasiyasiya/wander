# Phase 1 — Maps + Isochrone
# Google Maps JS API key (restrict to Maps JS API, HTTP referrers)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: your Google Cloud Map ID (leave empty to use DEMO_MAP_ID in dev)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# OpenRouteService API key — free at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Phase 2 — Database (Supabase or Postgres)
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# Phase 4 — LLM
LLM_PROVIDER_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
